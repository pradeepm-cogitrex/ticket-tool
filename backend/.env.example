# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=ticket_tool
# true = TypeORM creates/updates tables from entities (development only)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Attachments
UPLOAD_DIR=uploads

# Fill empty master tables and the starting employees on start-up
SEED_ON_START=true

# User notifications — leave empty until the credentials are ready; sends are then saved as "not configured"
# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="TicketDesk <support@example.com>"
# WhatsApp (WATI): API endpoint and access token from WATI › API Docs
WATI_API_URL=
WATI_TOKEN=
# Optional approved template; it receives name, ticket_no, subject, status and message as parameters.
# Without it a plain message is sent, which WhatsApp delivers only within 24 hours of the user's last message.
WATI_TEMPLATE_NAME=
